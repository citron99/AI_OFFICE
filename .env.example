APP_ENV=development
# Host-only development defaults. Compose uses its own internal service addresses.
EXECUTION_MODE=sync
AUTH_MODE=demo
# token: local invitation/session flow; oidc: exchange through OIDC_ISSUER_URL.
# Both modes require a strong, deployment-managed SESSION_SECRET.
# SESSION_SECRET=
# OIDC_ISSUER_URL=https://identity.example.com
# OIDC_ROLE_CLAIM=office_role
# OIDC_COMPANY_CLAIM=office_company
# For api_key mode set SHA-256 token hashes, never plaintext tokens:
# AUTH_TOKEN_HASHES={"<64-character-sha256>":{"user_id":"owner-a","role":"owner"}}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_office
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-5
ACCOUNTING_PROVIDER=mock
LEGAL_RAG_TOP_K=5
EMBEDDING_PROVIDER=mock
# Optional: local_sentence_transformer requires a trusted pre-downloaded model directory.
# EMBEDDING_MODEL_PATH=C:/models/approved-model-snapshot
EMBEDDING_DIMENSIONS=384
SEMANTIC_MIN_SCORE=0.3
# Opt-in: when true, the configured LLM receives source excerpts and attachment text.
LEGAL_ANALYSIS_ENABLED=false
LEGAL_ANALYSIS_TIMEOUT_SECONDS=45
LEGAL_DOCUMENT_MAX_CHARS=40000
AUTO_CREATE_SCHEMA=false
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# --- Object storage (TZ 9.5). Default: local directory. ---
# STORAGE_BACKEND=s3 requires a bucket (MinIO: docker compose --profile s3 up -d)
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=ai-office-artifacts
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
